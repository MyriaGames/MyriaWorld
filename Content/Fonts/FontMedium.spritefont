<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Georgia</FontName>
    <Size>25</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Bold</Style>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#160;</Start>
        <End>&#255;</End>
      </CharacterRegion>
      <!-- General Punctuation: en dash, em dash, ellipsis, smart quotes, bullet, etc. -->
      <CharacterRegion>
        <Start>&#8192;</Start>
        <End>&#8303;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
